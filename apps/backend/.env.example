# ==============================================================================
# Database Configuration (Neon PostgreSQL)
# ==============================================================================
# Pooled database connection string for Prisma application queries
DATABASE_URL="postgresql://user:password@ep-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct database connection string for migrations and direct pooling
DIRECT_URL="postgresql://user:password@ep-direct.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==============================================================================
# Server & Node Configuration
# ==============================================================================
PORT=3000
NODE_ID="node-1"
NODE_ENV="development"

# WARNING: ALLOW_DEV_USER_HEADER must NEVER be set to 'true' outside local development!
# In production, dev headers (x-dev-user-id / auth.userId) are strictly ignored.
ALLOW_DEV_USER_HEADER=false

# ==============================================================================
# Redis & Clustering Configuration
# ==============================================================================
# Redis URL for cluster pub/sub and distributed presence
REDIS_URL="redis://localhost:6379"
REDIS_KEY_PREFIX="kyu:"
# When 'true' or in NODE_ENV=production, server fails fast if Redis connection fails
REDIS_REQUIRED=false
# Maximum time (in ms) to wait for Redis connection before timing out
REDIS_CONNECT_TIMEOUT_MS=5000

# ==============================================================================
# Better Auth Configuration
# ==============================================================================
# Base URL where Better Auth is reached (e.g. Traefik load balancer or public domain)
BETTER_AUTH_URL="http://localhost:8080"
# Cryptographic secret for signing sessions and tokens. MUST BE IDENTICAL ON EVERY NODE!
BETTER_AUTH_SECRET="replace-with-a-secure-random-32-character-secret"

# Optional Auth switches
# Set to 'false' when running production builds over plain HTTP (e.g. localhost demo)
BETTER_AUTH_SECURE_COOKIES=false
# Set to 'false' for load testing only to disable Better Auth built-in rate limits
BETTER_AUTH_RATE_LIMIT_ENABLED=true

# ==============================================================================
# CORS & Frontend Origins
# ==============================================================================
# Comma-separated list of allowed frontend origins for CORS and Socket.IO
FRONTEND_URLS="http://localhost:5173"
# Fallback single frontend URL
FRONTEND_URL="http://localhost:5173"
